FROM node:20-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build -- --configuration production --base-href /apps/financial/

FROM nginx:1.27-alpine
COPY nginx.portal.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/financiero-web/browser /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=10 --start-period=10s CMD wget -qO- http://127.0.0.1/health || exit 1
